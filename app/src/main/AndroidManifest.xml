<?xml version="1.0" encoding="utf-8"?>
<!--
  allAround permissions. NOTE: there is deliberately NO android.permission.INTERNET (or any network
  permission). The build fails if any dependency adds one (see app/build.gradle.kts).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the front camera is used; the CAMERA permission would otherwise imply a required back camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />

    <!-- Front camera, only between a tilt onset and the decision. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Foreground service of type "camera" (Android 14+ requires the typed permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Android 13+: show the (minimal) foreground-service notification. Optional. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rotation applier, user picks ONE: overlay window or system rotation setting. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only used if the user enables "start on boot" (off by default; receiver disabled until then). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FaceTiltApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaceTilt"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.FaceTiltService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <service
            android:name=".tile.FaceTiltTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Disabled until the user turns on "start on boot" in settings. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
